+Function InLineOnAbort
+  ${If} $InLineTransactionReady = 1
+    !insertmacro InLineGuard "rollback"
+    ${If} $0 != 0
+      SetErrorLevel 2
+      DetailPrint "回滚未通过校验，恢复备份已保留；请勿启动本安装目录。"
+    ${EndIf}
+    StrCpy $InLineTransactionReady 0
+  ${EndIf}
+FunctionEnd
+Function .onInstFailed
+  Call InLineOnAbort
+FunctionEnd
+Function un.InLineOnAbort
+  ${If} $InLineTransactionReady = 1
+    !insertmacro InLineGuard "rollback"
+    ${If} $0 != 0
+      SetErrorLevel 2
+      DetailPrint "卸载回滚未通过校验，恢复备份已保留。"
+    ${EndIf}
+    StrCpy $InLineTransactionReady 0
+  ${EndIf}
+FunctionEnd
+Function un.onUninstFailed
+  Call un.InLineOnAbort
+FunctionEnd
